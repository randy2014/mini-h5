MYSQL_DATABASE=mini_novel
MYSQL_USERNAME=root
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password

# 对外入口（网关）：域名直接访问，不带端口；80 只做 301 跳转，业务走 443
GATEWAY_PORT=80
HTTPS_PORT=443
# 证书目录（必须放在 rsync 同步目录之外，否则部署会被 --delete 清掉）
# 需要 fullchain.pem（含中间证书）与 privkey.pem（未加密私钥），权限 600
TLS_CERT_DIR=/opt/mini-h5-certs

# 以下端口仅绑定 127.0.0.1，供网关与部署健康检查使用，不对外暴露
APP_PORT=8080
H5_PORT=5173
ADMIN_PORT=5180
